<Window x:Class="InternetCafe.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetZone Lock Screen" 
        WindowStyle="None" 
        WindowState="Maximized" 
        ResizeMode="NoResize" 
        Topmost="True"
        Background="#0B0F19"
        Closing="Window_Closing">
    <Grid>
        <!-- Background Overlay -->
        <Border Background="#1AFFFFFF" Opacity="0.05" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <TextBlock Text="NETZONE" FontSize="48" FontWeight="Bold" Foreground="#00F0FF" TextAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="MÁY TRẠM ĐANG KHÓA" FontSize="20" Foreground="#8A94A6" TextAlignment="Center" Margin="0,0,0,30" />

            <Border Background="#151A28" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="8" Padding="30">
                <StackPanel>
                    <TextBlock Text="Tên đăng nhập" Foreground="White" Margin="0,0,0,5" />
                    <TextBox x:Name="txtUsername" Background="#0B0F19" Foreground="White" BorderBrush="#2C3545" BorderThickness="1" Padding="10" Margin="0,0,0,15" FontSize="16" />

                    <TextBlock Text="Mật khẩu" Foreground="White" Margin="0,0,0,5" />
                    <PasswordBox x:Name="txtPassword" Background="#0B0F19" Foreground="White" BorderBrush="#2C3545" BorderThickness="1" Padding="10" Margin="0,0,0,25" FontSize="16" />

                    <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" Background="#00F0FF" Foreground="Black" FontWeight="Bold" FontSize="16" Padding="10" BorderThickness="0" Cursor="Hand" Click="btnLogin_Click" />
                    
                    <TextBlock x:Name="txtError" Text="" Foreground="#FF3366" TextAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            
            <TextBlock Text="Vui lòng liên hệ quầy thu ngân nếu cần hỗ trợ nạp tiền" Foreground="#5C6B89" FontSize="12" TextAlignment="Center" Margin="0,20,0,0" />
        </StackPanel>
        
        <!-- Main Workspace (Hidden initially) -->
        <Grid x:Name="WorkspaceGrid" Visibility="Collapsed" Background="#0B0F19">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="XIN CHÀO BẠN!" FontSize="40" Foreground="White" TextAlignment="Center" Margin="0,0,0,20" />
                <TextBlock x:Name="txtSessionInfo" Text="Số dư: 0đ | Thời gian còn lại: 00:00" FontSize="20" Foreground="#00F0FF" TextAlignment="Center" Margin="0,0,0,30" />
                
                <Button x:Name="btnLogout" Content="ĐĂNG XUẤT (KẾT THÚC PHIÊN)" Background="#FF3366" Foreground="White" FontWeight="Bold" FontSize="16" Padding="15,10" BorderThickness="0" Cursor="Hand" Click="btnLogout_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
