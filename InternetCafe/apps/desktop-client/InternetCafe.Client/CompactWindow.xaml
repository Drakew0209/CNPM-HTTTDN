<Window x:Class="InternetCafe.Client.CompactWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="InternetCafe · Theo dõi phiên" Width="350" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False" Closing="OnClosing" Background="#0B1226" Foreground="White">
 <StackPanel Margin="20"><TextBlock Text="{Binding MachineName}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionStatus}" Foreground="#A8BFDF" TextWrapping="Wrap" Margin="0,6,0,18"/><TextBlock Text="SỐ DƯ MÁY CHỦ" Foreground="#A8BFDF" FontSize="11"/><TextBlock Text="{Binding BalanceLabel}" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Đã sử dụng" Foreground="#A8BFDF"/><TextBlock Text="{Binding ElapsedLabel}" FontSize="21" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Còn lại dự kiến" Foreground="#A8BFDF"/><TextBlock Text="{Binding RemainingLabel}" FontSize="21" Margin="0,4,0,0"/></StackPanel></Grid><Border Background="#3A2A1A" CornerRadius="8" Padding="10" Margin="0,16,0,0" Visibility="{Binding LowBalance, Converter={StaticResource BoolVisible}}"><TextBlock Text="Số dư thấp · vui lòng nạp thêm tại quầy" Foreground="#FFD18A" TextWrapping="Wrap"/></Border><TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#A8BFDF" TextWrapping="Wrap" Margin="0,16,0,10"/><Button Content="Mở ứng dụng" Click="Restore" Background="#38D9FF" Foreground="#0B1226"/><Button Content="Kết thúc phiên" Command="{Binding EndSessionCommand}" IsEnabled="{Binding CanEndSession}" Foreground="White" Background="Transparent" BorderBrush="#38D9FF"/><TextBlock Text="Thời gian còn lại là ước tính." FontSize="10" Foreground="#A8BFDF" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
</Window>
