<Window x:Class="InternetCafe.Client.CompactWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="InternetCafe · Theo dõi phiên" Width="350" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False" Closing="OnClosing" Background="#193A32" Foreground="White">
 <StackPanel Margin="20"><TextBlock Text="{Binding MachineName}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionStatus}" Foreground="#BED9CA" TextWrapping="Wrap" Margin="0,6,0,18"/><TextBlock Text="SỐ DƯ MÁY CHỦ" Foreground="#BED9CA" FontSize="11"/><TextBlock Text="{Binding BalanceLabel}" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Đã sử dụng" Foreground="#BED9CA"/><TextBlock Text="{Binding ElapsedLabel}" FontSize="21" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Còn lại dự kiến" Foreground="#BED9CA"/><TextBlock Text="{Binding RemainingLabel}" FontSize="21" Margin="0,4,0,0"/></StackPanel></Grid><Border Background="#FFF0CC" CornerRadius="8" Padding="10" Margin="0,16,0,0" Visibility="{Binding LowBalance, Converter={StaticResource BoolVisible}}"><TextBlock Text="Số dư thấp · vui lòng nạp thêm tại quầy" Foreground="#70520C" TextWrapping="Wrap"/></Border><TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#BED9CA" TextWrapping="Wrap" Margin="0,16,0,10"/><Button Content="Mở ứng dụng" Click="Restore" Background="#A4E6C2" Foreground="#193A32"/><Button Content="Kết thúc phiên" Command="{Binding EndSessionCommand}" IsEnabled="{Binding CanEndSession}" Foreground="White" Background="Transparent" BorderBrush="#A4E6C2"/><TextBlock Text="Thời gian chỉ là ước tính. Phí do máy chủ quyết định." FontSize="10" Foreground="#BED9CA" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
</Window>
