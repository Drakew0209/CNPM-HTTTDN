<Window x:Class="InternetCafe.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Title="InternetCafe · Không gian của bạn" Width="1280" Height="850" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="#193A32" Padding="26,12"><DockPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><md:PackIcon Kind="GamepadVariant" Width="34" Height="34" Foreground="#A4E6C2" VerticalAlignment="Center" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="InternetCafe" Foreground="White" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="CHƠI HẾT MÌNH · KẾT NỐI HẾT CỠ" Foreground="#B9D3C6" FontSize="10"/></StackPanel></StackPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisible}}"><TextBlock Text="{Binding AccountName}" Foreground="White" VerticalAlignment="Center" Margin="18,0"/><Button Content="Cửa sổ gọn" Click="OpenCompact" Background="#A4E6C2" Foreground="#193A32"/><Button Content="Đăng xuất" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="White" BorderBrush="#9CB8AA"/></StackPanel>
  </DockPanel></Border>
  <StackPanel Grid.Row="1">
   <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}"/>
   <Border Background="#FCE5E4" Padding="24,10" Visibility="{Binding Error, Converter={StaticResource EmptyVisible}, ConverterParameter=Inverse}"><TextBlock Text="{Binding Error}" Foreground="#842F2F" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
   <Border Background="#DDF3E8" Padding="24,10" Visibility="{Binding Notice, Converter={StaticResource EmptyVisible}, ConverterParameter=Inverse}"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
   <Border Background="#FFF0CC" Padding="24,10" Visibility="{Binding LowBalance, Converter={StaticResource BoolVisible}}"><TextBlock Text="Số dư hoặc thời gian dự kiến còn thấp. Gửi yêu cầu nạp và thanh toán tại quầy để tiếp tục trải nghiệm." TextWrapping="Wrap" Foreground="#70520C"/></Border>
  </StackPanel>
  <Grid Grid.Row="2" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Margin="30" CornerRadius="24" Background="#DDF3E8" Padding="36"><StackPanel VerticalAlignment="Center"><TextBlock Text="Một chỗ ngồi.&#10;Cả thế giới&#10;đang chờ bạn." FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Quản lý thời gian chơi, gọi món và kết nối với đội ngũ hỗ trợ — trong một không gian của riêng bạn." Style="{StaticResource Muted}" FontSize="16" Margin="0,24,0,0"/><Border BorderBrush="#92B8A5" BorderThickness="0,1,0,0" Margin="0,36,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="TÀI KHOẢN DEMO" FontWeight="SemiBold"/><TextBlock Text="gamer / Demo@123" Margin="0,8,0,0"/><TextBlock Text="Máy pc-01 · API cục bộ cổng 5055" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="44,34" MaxWidth="510">
    <TextBlock Text="Chào mừng trở lại" Style="{StaticResource Heading}" Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}"/><TextBlock Text="Tạo tài khoản của bạn" Style="{StaticResource Heading}" Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}}"/>
    <TextBlock Text="Đăng nhập để bắt đầu phiên tại máy và quản lý dịch vụ." Style="{StaticResource Muted}"/>
    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Tên đăng nhập" MaxLength="30" AutomationProperties.Name="Tên đăng nhập"/>
    <PasswordBox x:Name="LoginPassword" Style="{StaticResource Secret}" md:HintAssist.Hint="Mật khẩu" PasswordChanged="OnPasswordChanged" Tag="Password" MaxLength="100" AutomationProperties.Name="Mật khẩu"/>
    <StackPanel Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}}">
     <PasswordBox Style="{StaticResource Secret}" md:HintAssist.Hint="Nhập lại mật khẩu" PasswordChanged="OnPasswordChanged" Tag="PasswordConfirmation" MaxLength="100" AutomationProperties.Name="Nhập lại mật khẩu"/>
     <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Họ và tên" MaxLength="100"/>
     <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Số điện thoại" MaxLength="13"/>
     <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Email" MaxLength="150"/>
     <TextBox Text="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Ngày sinh (yyyy-MM-dd)" MaxLength="10"/>
     <TextBox Text="{Binding Hobbies, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Sở thích" MaxLength="500" TextWrapping="Wrap"/>
     <Button Content="Tạo tài khoản" Command="{Binding RegisterCommand}"/>
    </StackPanel>
    <Button Content="Đăng nhập" Command="{Binding LoginCommand}" Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}"/>
    <Button Content="Chuyển đăng nhập / đăng ký" Command="{Binding ToggleRegistrationCommand}" Style="{StaticResource Secondary}" Margin="0,12,8,4"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Grid Grid.Row="2" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisible}}">
   <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTab}" TabStripPlacement="Left" Margin="14,20,24,0" Background="Transparent" BorderThickness="0">
    <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}"><Setter Property="MinWidth" Value="150"/><Setter Property="MinHeight" Value="52"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style></TabControl.Resources>
    <TabItem Header="Tổng quan"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,20">
     <TextBlock Text="Không gian của bạn" Style="{StaticResource Heading}"/><TextBlock Text="Thời gian để tập trung, chơi và kết nối." Style="{StaticResource Muted}"/>
     <Border Background="#DDF3E8" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding MachineName}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionStatus}" Margin="0,6,0,0"/><TextBlock Text="{Binding HourlyRateLabel}" Margin="0,6,0,16"/><WrapPanel><Button Content="Bắt đầu phiên" Command="{Binding StartSessionCommand}" IsEnabled="{Binding CanStartSession}"/><Button Content="Kết thúc phiên" Command="{Binding EndSessionCommand}" IsEnabled="{Binding CanEndSession}" Style="{StaticResource Secondary}"/><Button Content="Thu gọn" Click="OpenCompact" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel><md:PackIcon Grid.Column="1" Kind="Monitor" Width="92" Height="92" Foreground="#79AC94" Margin="20" VerticalAlignment="Center"/></Grid></Border>
     <UniformGrid Columns="3" Margin="0,0,0,4"><Border Style="{StaticResource Card}" Margin="0,0,14,18"><StackPanel><TextBlock Text="Số dư máy chủ" Style="{StaticResource Muted}"/><TextBlock Text="{Binding BalanceLabel}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Được xác nhận gần nhất" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,14,18"><StackPanel><TextBlock Text="Đã sử dụng" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ElapsedLabel}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Từ thời điểm bắt đầu phiên" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Còn lại dự kiến" Style="{StaticResource Muted}"/><TextBlock Text="{Binding RemainingLabel}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Ước tính, chưa phải hóa đơn" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
     <TextBlock Text="Thời gian còn lại chỉ là ước tính từ số dư, thời điểm và đơn giá nhận từ máy chủ. Máy chủ quyết định phí cuối cùng; thay đổi đơn giá trong phiên có thể làm ước tính khác hóa đơn." Style="{StaticResource Muted}"/>
     <TextBlock Text="{Binding SessionSummary}" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Lịch sử sử dụng" Style="{StaticResource Subheading}"/><Button Content="Gọi hỗ trợ" Command="{Binding RequestSupportCommand}" HorizontalAlignment="Right" Style="{StaticResource Secondary}"/></DockPanel><TextBlock Text="Chưa có phiên sử dụng." Style="{StaticResource Muted}" Visibility="{Binding Sessions.Count, Converter={StaticResource EmptyVisible}}"/><DataGrid ItemsSource="{Binding Sessions}" MaxHeight="270"><DataGrid.Columns><DataGridTextColumn Header="Máy" Binding="{Binding ComputerId}" Width="100"/><DataGridTextColumn Header="Bắt đầu" Binding="{Binding Started}" Width="*"/><DataGridTextColumn Header="Kết thúc" Binding="{Binding Ended}" Width="*"/><DataGridTextColumn Header="Phí máy chủ" Binding="{Binding Billed}" Width="140"/></DataGrid.Columns></DataGrid></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Thực đơn"><Grid Margin="24,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,18,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Nạp năng lượng" Style="{StaticResource Heading}"/><TextBlock Text="Món yêu thích sẽ được phục vụ tại máy của bạn." Style="{StaticResource Muted}"/><TextBox Text="{Binding MenuSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Tìm món"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="0,0,0,18" MinHeight="42" AutomationProperties.Name="Danh mục món"/><TextBlock Text="Không có món phù hợp." Style="{StaticResource Muted}" Visibility="{Binding Products.Count, Converter={StaticResource EmptyVisible}}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding PriceLabel}" Margin="0,8,0,0"/><TextBlock Text="{Binding StockLabel}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Thêm" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel>
     <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Giỏ món" Style="{StaticResource Subheading}"/><TextBlock Text="Cần phiên đang hoạt động tại máy này để đặt món." Style="{StaticResource Muted}"/><TextBlock Text="Chọn món bên trái để bắt đầu." Style="{StaticResource Muted}" Visibility="{Binding Cart.Count, Converter={StaticResource EmptyVisible}}"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,16"/><TextBlock Text="{Binding CartTotalLabel}" FontSize="27" FontWeight="SemiBold"/><TextBox Text="{Binding OrderNote, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Ghi chú cho quầy" Style="{StaticResource Field}" MaxLength="2000" TextWrapping="Wrap"/><Button Content="Xác nhận đặt món" Command="{Binding PlaceOrderCommand}" IsEnabled="{Binding CanOrder}"/><Button Content="Xóa giỏ" Command="{Binding ClearCartCommand}" Style="{StaticResource Secondary}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Cart}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><DockPanel><TextBlock Text="{Binding TotalLabel}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,2" MinHeight="32" Style="{StaticResource Secondary}" AutomationProperties.Name="Giảm số lượng"/><TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,2" MinHeight="32" Style="{StaticResource Secondary}" AutomationProperties.Name="Tăng số lượng"/></StackPanel></DockPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
    </Grid></TabItem>
    <TabItem Header="Đơn của tôi"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,20"><TextBlock Text="Đơn của tôi" Style="{StaticResource Heading}"/><TextBlock Text="Theo dõi món và hủy đơn còn ở trạng thái chờ xử lý." Style="{StaticResource Muted}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Chưa có đơn hàng." Style="{StaticResource Muted}" Visibility="{Binding Orders.Count, Converter={StaticResource EmptyVisible}}"/><DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" MaxHeight="460"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding Created}" Width="150"/><DataGridTextColumn Header="Món" Binding="{Binding Details}" Width="*"/><DataGridTextColumn Header="Tổng" Binding="{Binding TotalLabel}" Width="120"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="150"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding SelectedOrder.Note}" TextWrapping="Wrap" Margin="0,12,0,4"/><Button Content="Hủy đơn đã chọn" Command="{Binding CancelOrderCommand}" IsEnabled="{Binding CanCancelOrder}" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Ví và nạp tiền"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,20"><TextBlock Text="Ví và nạp tiền" Style="{StaticResource Heading}"/><TextBlock Text="Số dư được xác nhận từ máy chủ, sau khi thu ngân duyệt nạp." Style="{StaticResource Muted}"/><Border Style="{StaticResource Card}" Background="#DDF3E8"><StackPanel><TextBlock Text="{Binding BalanceLabel}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="Số dư hiện tại" Margin="0,8,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding TopupAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Số tiền yêu cầu (VND)" MaxLength="8" Margin="0,8,18,12"/><TextBox Grid.Column="1" Text="{Binding TopupNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Ghi chú" MaxLength="2000"/></Grid><Button Content="Gửi yêu cầu nạp tiền" Command="{Binding RequestTopupCommand}" IsEnabled="{Binding CanMutate}" HorizontalAlignment="Left"/><TextBlock Text="Sau khi gửi, đến quầy thanh toán. Yêu cầu đang chờ không làm tăng số dư." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Yêu cầu nạp tiền" Style="{StaticResource Subheading}"/><TextBlock Text="Chưa có yêu cầu nạp." Style="{StaticResource Muted}" Visibility="{Binding Topups.Count, Converter={StaticResource EmptyVisible}}"/><DataGrid ItemsSource="{Binding Topups}" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding Created}" Width="*"/><DataGridTextColumn Header="Số tiền" Binding="{Binding AmountLabel}" Width="150"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="150"/><DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Lịch sử giao dịch" Style="{StaticResource Subheading}"/><TextBlock Text="Chưa có giao dịch." Style="{StaticResource Muted}" Visibility="{Binding Transactions.Count, Converter={StaticResource EmptyVisible}}"/><DataGrid ItemsSource="{Binding Transactions}" MaxHeight="250"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding Created}" Width="*"/><DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="150"/><DataGridTextColumn Header="Số tiền" Binding="{Binding AmountLabel}" Width="150"/><DataGridTextColumn Header="Tham chiếu" Binding="{Binding ReferenceId}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Hồ sơ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,20"><TextBlock Text="Hồ sơ của bạn" Style="{StaticResource Heading}"/><TextBlock Text="Cập nhật thông tin và bảo vệ tài khoản của bạn." Style="{StaticResource Muted}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,18,18"><StackPanel><TextBlock Text="Thông tin cá nhân" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding Tier}" Style="{StaticResource Muted}"/><TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Họ và tên" MaxLength="100"/><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Số điện thoại" MaxLength="13"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Email" MaxLength="150"/><TextBox Text="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Ngày sinh (yyyy-MM-dd)" MaxLength="10"/><TextBox Text="{Binding Hobbies, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Sở thích" MaxLength="500" TextWrapping="Wrap"/><Button Content="Lưu hồ sơ" Command="{Binding SaveProfileCommand}" IsEnabled="{Binding CanMutate}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Đổi mật khẩu" Style="{StaticResource Subheading}"/><PasswordBox Style="{StaticResource Secret}" md:HintAssist.Hint="Mật khẩu hiện tại" Tag="CurrentPassword" PasswordChanged="OnPasswordChanged" MaxLength="100"/><PasswordBox Style="{StaticResource Secret}" md:HintAssist.Hint="Mật khẩu mới" Tag="NewPassword" PasswordChanged="OnPasswordChanged" MaxLength="100"/><PasswordBox Style="{StaticResource Secret}" md:HintAssist.Hint="Xác nhận mật khẩu mới" Tag="NewPasswordConfirmation" PasswordChanged="OnPasswordChanged" MaxLength="100"/><TextBlock Text="Tối thiểu 8 ký tự và khác mật khẩu đang sử dụng." Style="{StaticResource Muted}"/><Button Content="Đổi mật khẩu" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding CanMutate}"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Hỗ trợ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,20"><TextBlock Text="Luôn có người hỗ trợ" Style="{StaticResource Heading}"/><TextBlock Text="Gửi góp ý hoặc vấn đề tại máy. Nhân viên sẽ tiếp nhận từ quầy." Style="{StaticResource Muted}"/><Border Style="{StaticResource Card}"><StackPanel><TextBox Text="{Binding FeedbackSubject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Chủ đề" MaxLength="200"/><TextBox Text="{Binding FeedbackContent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" md:HintAssist.Hint="Bạn cần hỗ trợ điều gì?" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxLength="4000" VerticalScrollBarVisibility="Auto"/><Button Content="Gửi hỗ trợ" Command="{Binding SendFeedbackCommand}" IsEnabled="{Binding CanMutate}" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="Phản hồi của bạn" Style="{StaticResource Subheading}"/><TextBlock Text="Chưa có phản hồi." Style="{StaticResource Muted}" Visibility="{Binding FeedbackItems.Count, Converter={StaticResource EmptyVisible}}"/><ItemsControl ItemsSource="{Binding FeedbackItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding Created}" Style="{StaticResource Muted}" Margin="0,8,0,4"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusLabel}" Margin="0,12,0,4" Foreground="#27785A"/><TextBlock Text="{Binding Response}" TextWrapping="Wrap" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Khảo sát"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,20"><TextBlock Text="Trải nghiệm tốt hơn, cùng bạn" Style="{StaticResource Heading}"/><TextBlock Text="Các khảo sát được gửi riêng cho tài khoản của bạn." Style="{StaticResource Muted}"/><TextBlock Text="Hiện chưa có khảo sát dành cho bạn." Style="{StaticResource Muted}" Visibility="{Binding Surveys.Count, Converter={StaticResource EmptyVisible}}"/><ComboBox ItemsSource="{Binding Surveys}" SelectedItem="{Binding SelectedSurvey}" DisplayMemberPath="Title" MinHeight="48" Margin="0,10,0,18" AutomationProperties.Name="Chọn khảo sát"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding SelectedSurvey.Title}" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding SelectedSurvey.Description}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SurveyState}" Margin="0,0,0,18" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Answers}" IsEnabled="{Binding CanAnswerSurvey}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,22"><TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedAnswer}" MinHeight="44" AutomationProperties.Name="{Binding Text}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Gửi câu trả lời" Command="{Binding SubmitSurveyCommand}" IsEnabled="{Binding CanAnswerSurvey}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Border Background="#F0193A32" Visibility="{Binding IsAppLocked, Converter={StaticResource BoolVisible}}" Padding="36"><Border Background="#F3F6F3" CornerRadius="24" Padding="38" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><md:PackIcon Kind="LockOutline" Width="48" Height="48" Margin="0,0,0,20"/><TextBlock Text="Phiên sử dụng đã kết thúc" Style="{StaticResource Heading}" TextWrapping="Wrap"/><TextBlock Text="{Binding SessionSummary}" Style="{StaticResource Muted}"/><TextBlock Text="Đây là lớp phủ trong ứng dụng. Ứng dụng demo không khóa Windows, bàn phím hoặc các chương trình khác; cần agent hệ thống có phân quyền để triển khai khóa máy thật." Style="{StaticResource Muted}"/><Button Content="Trở về ứng dụng / nạp thêm" Command="{Binding UnlockAppCommand}"/><Button Content="Bắt đầu phiên mới" Command="{Binding StartSessionCommand}" IsEnabled="{Binding CanStartSession}" Style="{StaticResource Secondary}"/></StackPanel></Border></Border>
  </Grid>
  <Border Grid.Row="3" BorderBrush="#DCE5DF" BorderThickness="0,1,0,0" Padding="24,3"><DockPanel><TextBlock Text="{Binding ConnectionStatus}" FontSize="11" VerticalAlignment="Center"/><Button Content="Thử kết nối lại" Command="{Binding RefreshCommand}" MinHeight="22" Height="24" Padding="8,0" FontSize="11" Margin="16,0,0,0" Style="{StaticResource Secondary}" DockPanel.Dock="Right" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisible}}"/><TextBlock Text="{Binding LastSyncLabel}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel></Border>
 </Grid>
</Window>
