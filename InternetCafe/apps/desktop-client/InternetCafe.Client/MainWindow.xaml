<Window x:Class="InternetCafe.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Title="InternetCafe" Width="1280" Height="850" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid Background="#080D1B">
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="#0B1226" Padding="26,12"><DockPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><md:PackIcon Kind="GamepadVariant" Width="34" Height="34" Foreground="#38D9FF" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="InternetCafe" Foreground="White" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisible}}">
     <Border Background="#162E4A" BorderBrush="#00F2FE" BorderThickness="1.2" CornerRadius="8" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding VipBadge}" Foreground="#00F2FE" FontWeight="Bold" FontSize="11.5"/>
     </Border>
     <TextBlock Text="{Binding AccountName}" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold"/>
     <Button Command="{Binding ToggleSoundCommand}" ToolTip="Bật / Tắt âm thanh Cyberpunk" Background="#132342" Foreground="#38D9FF" BorderBrush="#253E6B" MinHeight="32" Height="32" Padding="10,0" Margin="0,0,10,0">
      <StackPanel Orientation="Horizontal">
       <md:PackIcon Kind="VolumeHigh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
       <TextBlock Text="SFX" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Content="Cửa sổ gọn" Click="OpenCompact" Background="#38D9FF" Foreground="#0B1226"/>
     <Button Content="Đăng xuất" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="White" BorderBrush="#59759C"/>
    </StackPanel>
  </DockPanel></Border>
  <StackPanel Grid.Row="1">
   <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}"/>
   <Border Background="#3A2A1A" Padding="24,10" Visibility="{Binding LowBalance, Converter={StaticResource BoolVisible}}"><TextBlock Text="Số dư hoặc thời gian thấp. Vui lòng nạp tại quầy." TextWrapping="Wrap" Foreground="#FFD18A"/></Border>
  </StackPanel>
  <!-- KIOSK ATTRACT MODE SCREENSAVER & CYBERPUNK LOGIN MODAL (Covers full window) -->
  <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="2000"
        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}">
   
   <!-- 1. Background Banner Carousel (Full Screen 16:9 Image with Dark Gradient Vignette) -->
   <Grid MouseDown="OnScreensaverClicked" Cursor="Hand" Background="#080D1B">
    <Image Source="{Binding CurrentBannerImage, Converter={StaticResource ImageSourceConverter}}"
           Stretch="UniformToFill"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
    
    <!-- Dark Cyber Vignette Overlay for Crisp Readability -->
    <Grid>
     <Grid.Background>
      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
       <GradientStop Color="#B0050A14" Offset="0"/>
       <GradientStop Color="#40080D1B" Offset="0.3"/>
       <GradientStop Color="#30080D1B" Offset="0.6"/>
       <GradientStop Color="#E6050914" Offset="1"/>
      </LinearGradientBrush>
     </Grid.Background>
    </Grid>

    <!-- Top HUD Header (Station Info & Cyber Branding) -->
    <Grid VerticalAlignment="Top" Margin="32,24,32,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>

     <!-- Left: Logo & Cyber Brand -->
     <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
      <Border Background="#122544" BorderBrush="#00F2FE" BorderThickness="1.5" CornerRadius="12" Padding="8" Margin="0,0,14,0">
       <Border.Effect>
        <DropShadowEffect Color="#00F2FE" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
       </Border.Effect>
       <md:PackIcon Kind="GamepadVariant" Width="28" Height="28" Foreground="#00F2FE"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="CYBER" Foreground="#00F2FE" FontSize="19" FontWeight="Black" Margin="0,0,6,0"/>
        <TextBlock Text="MATRIX GAMING" Foreground="White" FontSize="19" FontWeight="Black"/>
       </StackPanel>
       <TextBlock Text="HỆ THỐNG PHÒNG MÁY ESPORTS CHUYÊN NGHIỆP" Foreground="#7AA4D4" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
      </StackPanel>
     </StackPanel>

     <!-- Right: Station Badges -->
     <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
      <!-- Machine ID Badge -->
      <Border Background="#132442" BorderBrush="#38D9FF" BorderThickness="1.2" CornerRadius="10" Padding="14,6" Margin="0,0,10,0">
       <StackPanel Orientation="Horizontal">
        <md:PackIcon Kind="Monitor" Width="18" Height="18" Foreground="#38D9FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock Text="{Binding MachineName, StringFormat='MÁY: {0}'}" Foreground="#38D9FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>

      <!-- Hardware Specs Chip -->
      <Border Background="#0E192E" BorderBrush="#2A4370" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,10,0">
       <StackPanel Orientation="Horizontal">
        <md:PackIcon Kind="LightningBolt" Width="16" Height="16" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBlock Text="RTX 4070 · 240Hz 1ms · Fiber 1G" Foreground="#A9C7EC" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>

      <!-- Hourly Rate Badge -->
      <Border Background="#113620" BorderBrush="#34D399" BorderThickness="1.2" CornerRadius="10" Padding="14,6">
       <StackPanel Orientation="Horizontal">
        <md:PackIcon Kind="CashFast" Width="18" Height="18" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock Text="{Binding HourlyRateLabel, StringFormat='GIÁ: {0}'}" Foreground="#34D399" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>

    <!-- Center & Bottom Screensaver Attract Content (Hidden when Login Modal is Open) -->
    <Grid VerticalAlignment="Bottom" Margin="0,0,0,46"
          Visibility="{Binding IsLoginModalOpen, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}">
     <StackPanel HorizontalAlignment="Center">
      
      <!-- Live Cyber HUD Digital Clock -->
      <TextBlock Text="{Binding DigitalClock}"
                 FontSize="68"
                 FontWeight="Black"
                 Foreground="#FFFFFF"
                 HorizontalAlignment="Center"
                 TextAlignment="Center">
       <TextBlock.Effect>
        <DropShadowEffect Color="#00F2FE" BlurRadius="24" ShadowDepth="0" Opacity="0.85"/>
       </TextBlock.Effect>
      </TextBlock>

      <!-- Vietnamese Date -->
      <TextBlock Text="{Binding DigitalDate}"
                 FontSize="17"
                 FontWeight="SemiBold"
                 Foreground="#A6C8EE"
                 HorizontalAlignment="Center"
                 Margin="0,2,0,26"/>

      <!-- Pulsing Call-To-Action Button -->
      <Button Command="{Binding OpenLoginModalCommand}"
              Height="54"
              Padding="36,0"
              Background="#00F2FE"
              Foreground="#040914"
              FontWeight="Black"
              FontSize="15"
              BorderThickness="0"
              Cursor="Hand">
       <Button.Resources>
        <Style TargetType="Border">
         <Setter Property="CornerRadius" Value="27"/>
        </Style>
       </Button.Resources>
       <Button.Effect>
        <DropShadowEffect Color="#00F2FE" BlurRadius="28" ShadowDepth="0" Opacity="0.95"/>
       </Button.Effect>
       <StackPanel Orientation="Horizontal">
        <md:PackIcon Kind="CursorPointer" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Text="CHẠM CHUỘT HOẶC NHẤN PHÍM BẤT KỲ ĐỂ BẮT ĐẦU" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>

      <!-- Banner 3-Dot Indicators -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
       <!-- Dot 0 -->
       <Button Command="{Binding SelectBannerCommand}" CommandParameter="0"
               Margin="5,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="14">
        <Border Height="8" CornerRadius="4">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="#355075"/>
           <Setter Property="Width" Value="8"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentBannerIndex}" Value="0">
             <Setter Property="Background" Value="#00F2FE"/>
             <Setter Property="Width" Value="28"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
        </Border>
       </Button>

       <!-- Dot 1 -->
       <Button Command="{Binding SelectBannerCommand}" CommandParameter="1"
               Margin="5,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="14">
        <Border Height="8" CornerRadius="4">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="#355075"/>
           <Setter Property="Width" Value="8"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentBannerIndex}" Value="1">
             <Setter Property="Background" Value="#00F2FE"/>
             <Setter Property="Width" Value="28"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
        </Border>
       </Button>

       <!-- Dot 2 -->
       <Button Command="{Binding SelectBannerCommand}" CommandParameter="2"
               Margin="5,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="14">
        <Border Height="8" CornerRadius="4">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="#355075"/>
           <Setter Property="Width" Value="8"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentBannerIndex}" Value="2">
             <Setter Property="Background" Value="#00F2FE"/>
             <Setter Property="Width" Value="28"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
        </Border>
       </Button>
      </StackPanel>

     </StackPanel>
    </Grid>

    <!-- Bottom Right: Quick Exit (Screensaver Mode) -->
    <Button Click="OnExitClick"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,24,20"
            Background="Transparent"
            BorderBrush="#354968"
            BorderThickness="1"
            Foreground="#8FAACD"
            Padding="12,6"
            Cursor="Hand"
            Visibility="{Binding IsLoginModalOpen, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}">
     <StackPanel Orientation="Horizontal">
      <md:PackIcon Kind="Power" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="Thoát (Esc)" FontSize="12" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>

   </Grid>

   <!-- 2. Dark Glassmorphism Modal Backdrop & Cyber Mini Login Card (Active when IsLoginModalOpen == true) -->
   <Grid Visibility="{Binding IsLoginModalOpen, Converter={StaticResource BoolVisible}}">
    <!-- Dark Dimming Backdrop (Click to return to screensaver) -->
    <Border Background="#C4050914" MouseDown="OnScreensaverBackgroundClicked"/>

    <!-- Centered Cyber Mini Login Card -->
    <Border Background="#F20D172E"
            BorderBrush="#00F2FE"
            BorderThickness="1.5"
            CornerRadius="24"
            Padding="36,30"
            Width="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
     <Border.Effect>
      <DropShadowEffect Color="#00F2FE" BlurRadius="36" ShadowDepth="0" Opacity="0.6"/>
     </Border.Effect>
     <StackPanel>
      <!-- Modal Header with Close Button -->
      <DockPanel LastChildFill="False" Margin="0,0,0,16">
       <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#142848" CornerRadius="10" Padding="8" Margin="0,0,12,0">
         <md:PackIcon Kind="AccountKey" Width="26" Height="26" Foreground="#00F2FE"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="HỘI VIÊN ĐĂNG NHẬP"
                    Foreground="White"
                    FontSize="19"
                    FontWeight="Bold"
                    Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}"/>
         <TextBlock Text="ĐĂNG KÝ HỘI VIÊN MỚI"
                    Foreground="White"
                    FontSize="19"
                    FontWeight="Bold"
                    Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}}"/>
         <TextBlock Text="Nhập tài khoản để mở khóa sử dụng"
                    Foreground="#7FA0C8"
                    FontSize="11.5"
                    Margin="0,2,0,0"/>
        </StackPanel>
       </StackPanel>
       
       <!-- Close Button (✕) -->
       <Button DockPanel.Dock="Right"
               Command="{Binding CloseLoginModalCommand}"
               Width="32"
               Height="32"
               Padding="0"
               Background="#182A4A"
               BorderThickness="0"
               Foreground="#A4C4E8"
               ToolTip="Quay lại màn hình chờ"
               Cursor="Hand"
               VerticalAlignment="Center">
        <Button.Resources>
         <Style TargetType="Border">
          <Setter Property="CornerRadius" Value="16"/>
         </Style>
        </Button.Resources>
        <md:PackIcon Kind="Close" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Button>
      </DockPanel>

      <!-- Error / Notice Banner in Login Card -->
      <Border Background="#451818" BorderBrush="#FF5C5C" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14"
              Visibility="{Binding Error, Converter={StaticResource EmptyVisible}, ConverterParameter=Inverse}">
       <StackPanel Orientation="Horizontal">
        <md:PackIcon Kind="AlertCircle" Width="18" Height="18" Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding Error}" Foreground="#FFC1C1" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>

      <!-- Input Fields -->
      <TextBox x:Name="LoginUsername"
               Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource Field}"
               md:HintAssist.Hint="Tên đăng nhập"
               MaxLength="30"
               KeyDown="OnLoginFieldKeyDown"
               AutomationProperties.Name="Tên đăng nhập"
               Margin="0,0,0,14"/>

      <PasswordBox x:Name="LoginPassword"
                   Style="{StaticResource Secret}"
                   md:HintAssist.Hint="Mật khẩu"
                   PasswordChanged="OnPasswordChanged"
                   KeyDown="OnLoginFieldKeyDown"
                   Tag="Password"
                   MaxLength="100"
                   AutomationProperties.Name="Mật khẩu"
                   Margin="0,0,0,14"/>

      <!-- Registration Extra Fields -->
      <StackPanel Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}}">
       <PasswordBox Style="{StaticResource Secret}"
                    md:HintAssist.Hint="Nhập lại mật khẩu"
                    PasswordChanged="OnPasswordChanged"
                    KeyDown="OnLoginFieldKeyDown"
                    Tag="PasswordConfirmation"
                    MaxLength="100"
                    AutomationProperties.Name="Nhập lại mật khẩu"
                    Margin="0,0,0,14"/>
       <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource Field}"
                md:HintAssist.Hint="Họ và tên"
                MaxLength="100"
                KeyDown="OnLoginFieldKeyDown"
                Margin="0,0,0,14"/>
       <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource Field}"
                md:HintAssist.Hint="Số điện thoại"
                MaxLength="13"
                KeyDown="OnLoginFieldKeyDown"
                Margin="0,0,0,14"/>
       <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource Field}"
                md:HintAssist.Hint="Email"
                MaxLength="150"
                KeyDown="OnLoginFieldKeyDown"
                Margin="0,0,0,14"/>
       <TextBox Text="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource Field}"
                md:HintAssist.Hint="Ngày sinh (yyyy-MM-dd)"
                MaxLength="10"
                KeyDown="OnLoginFieldKeyDown"
                Margin="0,0,0,14"/>
       <TextBox Text="{Binding Hobbies, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource Field}"
                md:HintAssist.Hint="Sở thích"
                MaxLength="500"
                TextWrapping="Wrap"
                Margin="0,0,0,14"/>
       
       <Button Content="TẠO TÀI KHOẢN MỚI"
               Command="{Binding RegisterCommand}"
               Height="46"
               Background="#00F2FE"
               Foreground="#040914"
               FontWeight="Bold"
               FontSize="14"
               Margin="0,6,0,0"
               Cursor="Hand"/>
      </StackPanel>

      <!-- Login Button -->
      <Button Content="ĐĂNG NHẬP MỞ MÁY"
              Command="{Binding LoginCommand}"
              Visibility="{Binding IsRegistering, Converter={StaticResource BoolVisible}, ConverterParameter=Inverse}"
              Height="48"
              Background="#00F2FE"
              Foreground="#040914"
              FontWeight="Black"
              FontSize="15"
              Margin="0,4,0,0"
              Cursor="Hand">
       <Button.Resources>
        <Style TargetType="Border">
         <Setter Property="CornerRadius" Value="12"/>
        </Style>
       </Button.Resources>
       <Button.Effect>
        <DropShadowEffect Color="#00F2FE" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
       </Button.Effect>
      </Button>

      <!-- Toggle Login / Register Button -->
      <Button Content="Chuyển đăng nhập / đăng ký"
              Command="{Binding ToggleRegistrationCommand}"
              Style="{StaticResource Secondary}"
              Margin="0,14,0,0"
              Cursor="Hand"/>

      <!-- Back to Screensaver Button -->
      <Button Content="Quay lại màn hình chờ"
              Command="{Binding CloseLoginModalCommand}"
              Style="{StaticResource Secondary}"
              Foreground="#8FAACD"
              Margin="0,8,0,0"
              Cursor="Hand"/>
     </StackPanel>
    </Border>
   </Grid>

  </Grid>
  <Grid Grid.Row="2" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisible}}">
   <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTab}" TabStripPlacement="Left" Margin="14,20,24,0" Background="#080D1B" BorderThickness="0">
    <TabControl.Resources>
      <Style TargetType="TabItem">
       <Setter Property="MinWidth" Value="176"/>
       <Setter Property="MinHeight" Value="44"/>
       <Setter Property="Margin" Value="0,0,0,5"/>
       <Setter Property="Foreground" Value="#8FAACD"/>
       <Setter Property="Cursor" Value="Hand"/>
       <Setter Property="Template">
        <Setter.Value>
         <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" CornerRadius="10" Background="Transparent" Padding="12,9" Margin="0,0,14,0">
           <Grid>
            <!-- Left Neon Accent Bar for Active State -->
            <Border x:Name="ActiveBar" Width="3.2" HorizontalAlignment="Left" CornerRadius="1.6" Background="#00F2FE" Opacity="0" Margin="-12,-2,0,-2">
             <Border.Effect>
              <DropShadowEffect Color="#00F2FE" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
             </Border.Effect>
            </Border>
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="6,0,0,0"/>
           </Grid>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="TabBorder" Property="Background" Value="#13233E"/>
            <Setter Property="Foreground" Value="#E2EDF9"/>
           </Trigger>
           <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="TabBorder" Property="Background">
             <Setter.Value>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
               <GradientStop Color="#183158" Offset="0"/>
               <GradientStop Color="#0F1E38" Offset="1"/>
              </LinearGradientBrush>
             </Setter.Value>
            </Setter>
            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="#00F2FE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
           </Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Setter.Value>
       </Setter>
      </Style>
      <Style TargetType="ScrollViewer">
       <Setter Property="RenderTransform">
        <Setter.Value>
         <TranslateTransform Y="0"/>
        </Setter.Value>
       </Setter>
       <Style.Triggers>
        <EventTrigger RoutedEvent="Loaded">
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.22">
            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
           <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </EventTrigger>
       </Style.Triggers>
      </Style>
     </TabControl.Resources>
    <TabItem>
     <TabItem.Header>
      <DockPanel Width="146">
       <md:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" Foreground="#00F2FE" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock Text="Tổng quan" FontSize="13" VerticalAlignment="Center"/>
      </DockPanel>
     </TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,0,20">
     <TextBlock Text="Tổng quan" Style="{StaticResource Heading}"/>
     <Border Style="{StaticResource Card}" Padding="0" Background="#0C152B" BorderBrush="#1C2E52" BorderThickness="1.5">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>

       <!-- Left Cyan Accent Line -->
       <Border Background="#00F2FE" CornerRadius="16,0,0,16">
        <Border.Effect>
         <DropShadowEffect Color="#00F2FE" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>
       </Border>

       <!-- Left Info & Actions -->
       <StackPanel Grid.Column="1" Margin="28,20">
        <!-- Status Badge Row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
         <Border Background="#14352E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
           <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
           </Border>
           <TextBlock Text="ĐANG HOẠT ĐỘNG · BẢO VỆ PHÒNG MÁY" Foreground="#55F2A3" FontSize="11" FontWeight="Bold"/>
          </StackPanel>
         </Border>

         <Border Background="#162E4A" BorderBrush="#00F2FE" BorderThickness="1" CornerRadius="8" Padding="10,4">
          <TextBlock Text="{Binding HourlyRateLabel, StringFormat='🏷️ ĐƠN GIÁ: {0}'}" Foreground="#38D9FF" FontSize="11" FontWeight="Bold"/>
         </Border>
        </StackPanel>

        <!-- Machine Name & Status -->
        <TextBlock Text="{Binding MachineName}" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding SessionStatus}" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,16"/>

        <!-- Action Buttons -->
        <WrapPanel>
         <Button Command="{Binding EndSessionCommand}" IsEnabled="{Binding CanEndSession}"
                 Background="#2E1724" BorderBrush="#EF4444" BorderThickness="1.2" Foreground="#FCA5A5"
                 Cursor="Hand" MinHeight="36" Height="36" Padding="14,0" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
           <md:PackIcon Kind="PowerStandby" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
           <TextBlock Text="Kết thúc phiên" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
         </Button>

         <Button Click="OpenCompact"
                 Background="#132B45" BorderBrush="#00F2FE" BorderThickness="1.2" Foreground="#38D9FF"
                 Cursor="Hand" MinHeight="36" Height="36" Padding="14,0" Margin="0,0,10,0">
