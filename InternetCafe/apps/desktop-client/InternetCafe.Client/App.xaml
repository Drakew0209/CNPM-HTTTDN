<Application x:Class="InternetCafe.Client.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local="clr-namespace:InternetCafe.Client">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <md:BundledTheme BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="Teal"/>
   <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <local:BooleanVisibilityConverter x:Key="BoolVisible"/><local:EmptyVisibilityConverter x:Key="EmptyVisible"/>
  <SolidColorBrush x:Key="Ink" Color="#193A32"/><SolidColorBrush x:Key="Mint" Color="#DDF3E8"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F3F6F3"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/><Setter Property="BorderBrush" Value="#DCE5DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Subheading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#566961"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"><Setter Property="Margin" Value="0,8,0,12"/><Setter Property="MinHeight" Value="52"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Secret" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}"><Setter Property="Margin" Value="0,8,0,12"/><Setter Property="MinHeight" Value="52"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}"><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Padding" Value="16,6"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}"><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Padding" Value="16,6"/></Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="MinHeight" Value="90"/><Setter Property="RowHeight" Value="44"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
