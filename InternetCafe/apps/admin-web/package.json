{
  "name": "internetcafe-admin-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:shared": "vite --mode http --host 127.0.0.1 --port 5173 --strictPort",
    "demo": "concurrently -k -n api,web \"npm:mock:server\" \"npm:dev:shared\"",
    "mock:server": "tsx ../../mock/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^6.6.5",
    "msw": "^2.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.0",
    "yaml": "^2.8.0"
  },
  "msw": { "workerDirectory": ["public"] }
}
